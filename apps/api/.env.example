PORT=4000
MET_PROVIDER=auto
MET_TOKEN=
CHECKWX_TOKEN=
AVWX_TOKEN=
MET_PROVIDER_TIMEOUT_MS=3500

NOTAM_PROVIDER=simulated
NOTAM_SYNTHETIC_MODE=hybrid
NOTAM_SEED_BUCKET_HOURS=6
NOTAM_PROVIDER_TIMEOUT_MS=5000
SKYLINK_API_KEY=
SKYLINK_API_HOST=skylink-api.p.rapidapi.com
SKYLINK_API_URL=https://skylink-api.p.rapidapi.com/notams

AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=2500
RISK_MODEL_PATH=services/nlp/models/risk_model.json

# Optional real LLM layer for services/nlp.
# Keep real keys in apps/api/.env.local; never commit secrets.
LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_NOTAM_PARSE=true
LLM_BRIEF_REPORT=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=8000
