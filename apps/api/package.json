{
  "name": "api",
  "version": "0.0.1",
  "type": "commonjs",
  "scripts": {
    "ingest:airports": "ts-node scripts/ingest-airports.ts",
    "build:api": "npm --prefix apps/api run ingest:airports && tsc -p apps/api/tsconfig.json",
    "dev": "nodemon --watch src --ext ts --exec \"ts-node src/index.ts\"",
    "test:notam": "ts-node test/notam.provider.test.ts",
    "test:notam:live": "ts-node test/notam.live-smoke.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@flight-risk/shared": "file:../../packages/shared",
    "@types/pdfkit": "^0.17.4",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.2.1",
    "node-fetch": "^3.3.2",
    "pdfkit": "^0.17.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
